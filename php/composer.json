            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "colornamefinder",
        "color name",
        "hex to color",
        "color lookup",
        "named colors",
        "css colors"
    ],
    "homepage": "https://apiverve.com/marketplace/colornamefinder?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
